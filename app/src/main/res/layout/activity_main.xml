<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <View
            android:layout_width="6dp"
            android:layout_height="30dp"
            android:background="@color/red" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRestaurant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_3"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/chipShift"
            style="@style/Haji.Chip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipPrinter"
            style="@style/Haji.Chip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipUser"
            style="@style/Haji.Chip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnOrders"
            style="@style/Haji.Btn.Dark"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginEnd="8dp"
            android:text="الطلبات السابقة" />

        <TextView
            android:id="@+id/btnAdmin"
            style="@style/Haji.Btn.Dark"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:layout_marginEnd="8dp"
            android:text="☰ الإدارة" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/Haji.Btn.Outline"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="خروج" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvShiftWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/red_soft"
        android:gravity="center"
        android:padding="8dp"
        android:text="لا توجد وردية مفتوحة — اضغط هنا لفتح وردية قبل اعتماد الطلبات"
        android:textColor="@color/warning"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- الطلب الحالي (يمين) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="34"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Haji.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الطلب الحالي" />

                <TextView
                    android:id="@+id/tvItemCount"
                    style="@style/Haji.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/segDineIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/segment"
                    android:gravity="center"
                    android:text="داخل المطعم"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/segTakeaway"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/segment"
                    android:gravity="center"
                    android:text="سفري"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTable"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_outline"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/lvLines"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/stroke"
                    android:dividerHeight="1dp" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="الطلب فارغ\nاختر صنفاً من القائمة"
                    android:textColor="@color/text_3"
                    android:textSize="13sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/surface"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="المجموع"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvDiscountLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الخصم"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="الإجمالي"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNew"
                    style="@style/Haji.Btn.Dark"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="طلب جديد" />

                <TextView
                    android:id="@+id/btnDiscount"
                    style="@style/Haji.Btn.Dark"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="خصم" />

                <TextView
                    android:id="@+id/btnClear"
                    style="@style/Haji.Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="إلغاء الطلب"
                    android:textColor="@color/error" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnConfirm"
                    style="@style/Haji.Btn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="2"
                    android:textSize="16sp"
                    android:text="تأكيد الطلب" />

                <TextView
                    android:id="@+id/btnPrint"
                    style="@style/Haji.Btn.Dark"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="طباعة الفاتورة" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastInvoice"
                style="@style/Haji.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- الأصناف (وسط) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="50"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryTitle"
                style="@style/Haji.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <GridView
                    android:id="@+id/gvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnWidth="150dp"
                    android:horizontalSpacing="8dp"
                    android:listSelector="@color/transparent"
                    android:numColumns="auto_fit"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="8dp" />

                <TextView
                    android:id="@+id/tvNoProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="20dp"
                    android:textColor="@color/text_3"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- الأقسام (يسار) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="16"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/Haji.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="6dp"
                android:text="الأقسام" />

            <ListView
                android:id="@+id/lvCategories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/transparent"
                android:dividerHeight="6dp"
                android:listSelector="@color/transparent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
