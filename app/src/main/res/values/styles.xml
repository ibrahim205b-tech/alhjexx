<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Haji.Btn" parent="">
        <item name="android:layout_height">@dimen/btn_h</item>
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/btn_red</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Haji.Btn.Dark">
        <item name="android:background">@drawable/btn_dark</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Haji.Btn.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Haji.Title" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Haji.Caption" parent="">
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Haji.Chip" parent="">
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:background">@drawable/chip</item>
    </style>
</resources>
